// Experimental native IETF ChaCha20-Poly1305 (RFC 8439), not XChaCha20.
// No C crypto calls. Fixed rounds, limb arithmetic and full-tag comparison;
// generated code and side-channel behavior have not been independently audited.
// Scratch retains key material; callers must use a vetted erasure mechanism.
Ptr = std.mem
Range = std.core
bit_xor, bit_and, rotate_right, to_u32, to_u64, to_usize, to_u8 = std.core.num

// Key spans 32 readable bytes; nonce spans 12. Never reuse a nonce with a key.
// Scratch spans >=40 aligned u64 words and cannot overlap any other buffer.
// Input/output may be exactly identical; all other overlapping spans are invalid
// caller usage, including output overlapping AAD, key or nonce. No allocation.
// Null input/AAD is permitted only for zero length. Output must be non-null.
// seal appends a full 16-byte tag. open checks it before writing any plaintext.
// Invalid arguments and failed authentication leave output unchanged.
chacha20poly1305_seal* = (
    output          : Ptr<u8>,
    output_capacity : usize,
    message         : Ptr<u8>,
    message_count   : usize,
    aad             : Ptr<u8>,
    aad_count       : usize,
    key             : Ptr<u8>,
    nonce           : Ptr<u8>,
    scratch         : Ptr<u64>,
    scratch_words   : usize
) bool {
    valid = message_count <= 274877906880 && output_capacity >= 16
        && message_count <= output_capacity - 16
        && spans(
            output,
            message,
            message_count,
            aad,
            aad_count,
            key,
            nonce,
            scratch,
            scratch_words
        );
    valid.match({
        false => false,
        true  => {
            initialize(scratch, key, nonce);
            stream_xor(scratch, output, message, message_count);
            authenticate(scratch, aad, aad_count, output, message_count);
            output.offset(message_count).copy_from(scratch.offset(38).to<u8>(), 16);
            true
        },
    })
}
chacha20poly1305_open* = (
    output           : Ptr<u8>,
    output_capacity  : usize,
    ciphertext       : Ptr<u8>,
    ciphertext_count : usize,
    aad              : Ptr<u8>,
    aad_count        : usize,
    key              : Ptr<u8>,
    nonce            : Ptr<u8>,
    scratch          : Ptr<u64>,
    scratch_words    : usize
) bool {
    valid = ciphertext_count >= 16 && ciphertext_count <= 274877906896
        && ciphertext_count - 16 <= output_capacity
        && spans(
            output,
            ciphertext,
            ciphertext_count,
            aad,
            aad_count,
            key,
            nonce,
            scratch,
            scratch_words
        );
    valid.match({
        false => false,
        true  => {
            count = ciphertext_count - 16;
            initialize(scratch, key, nonce);
            authenticate(scratch, aad, aad_count, ciphertext, count);
            tag = scratch.offset(38).to<u8>();
            different: u32 ::= 0;
            Range(0, 16).loop((i) {
                different = different +% tag.read(i).to_u32().bit_xor(ciphertext.read(count + i).to_u32());
            });
            (different == 0).match({
                false => false,
                true  => { stream_xor(
                    scratch,
                    output,
                    ciphertext,
                    count
                ); true },
            })
        },
    })
}
spans = (
    output        : Ptr<u8>,
    input         : Ptr<u8>,
    count         : usize,
    aad           : Ptr<u8>,
    aad_count     : usize,
    key           : Ptr<u8>,
    nonce         : Ptr<u8>,
    scratch       : Ptr<u64>,
    scratch_words : usize
) bool {
    !output.is_null() && (count == 0 || !input.is_null()) && (aad_count == 0 || !aad.is_null())
        && !key.is_null() && !nonce.is_null() && !scratch.is_null() && scratch_words >= 40
}
byte = (value: u64) u8 {
    (value % 256).to_usize().match({Ok(n) => n.to_u8().match({Ok(b) => b, None => 0}), None => 0})
}
load32 = (input: Ptr<u8>, offset: usize) u32 {
    input.read(offset).to_u32() + input.read(offset + 1).to_u32() * 256
        + input.read(offset + 2).to_u32() * 65536 + input.read(offset + 3).to_u32() * 16777216
}
store = (output: Ptr<u8>, value: u64, count: usize) {
    word ::= value;
    Range(0, count).loop((i) { output.write(i, byte(word)); word = word / 256; });
}
quarter = (v: Ptr<u32>, a: usize, b: usize, c: usize, d: usize) {
    v.write(a, v.read(a) +% v.read(b));
    v.write(d, v.read(d).bit_xor(v.read(a)).rotate_right(16));
    v.write(c, v.read(c) +% v.read(d));
    v.write(b, v.read(b).bit_xor(v.read(c)).rotate_right(20));
    v.write(a, v.read(a) +% v.read(b));
    v.write(d, v.read(d).bit_xor(v.read(a)).rotate_right(24));
    v.write(c, v.read(c) +% v.read(d));
    v.write(b, v.read(b).bit_xor(v.read(c)).rotate_right(25));
}
block = (scratch: Ptr<u64>, counter: u32) {
    v = scratch.to<u32>(); initial = scratch.offset(8).to<u32>();
    initial.write(12, counter);
    Range(0, 16).loop((i) { v.write(i, initial.read(i)); });
    Range(0, 10).loop((round) {
        quarter(v, 0, 4, 8, 12); quarter(v, 1, 5, 9, 13);
        quarter(v, 2, 6, 10, 14); quarter(v, 3, 7, 11, 15);
        quarter(v, 0, 5, 10, 15); quarter(v, 1, 6, 11, 12);
        quarter(v, 2, 7, 8, 13); quarter(v, 3, 4, 9, 14);
    });
    output = scratch.offset(16).to<u8>();
    Range(0, 16).loop((i) { store(output.offset(i * 4), (v.read(i) +% initial.read(i)).to_u64(), 4); });
}
initialize = (scratch: Ptr<u64>, key: Ptr<u8>, nonce: Ptr<u8>) {
    initial = scratch.offset(8).to<u32>();
    initial.write(0, 1634760805); initial.write(1, 857760878);
    initial.write(2, 2036477234); initial.write(3, 1797285236);
    Range(0, 8).loop((i) { initial.write(4 + i, load32(key, i * 4)); });
    Range(0, 3).loop((i) { initial.write(13 + i, load32(nonce, i * 4)); });
    block(scratch, 0);
    one_time = scratch.offset(16).to<u8>();
    // RFC clamp: high four bits of bytes3,7,11,15; low two of4,8,12.
    Range(0, 4).loop((i) { one_time.write(3 + 4 * i, byte(one_time.read(3 + 4 * i).to_u64().bit_and(15))); });
    Range(1, 4).loop((i) { one_time.write(4 * i, byte(one_time.read(4 * i).to_u64().bit_and(252))); });
    p = scratch.offset(24);
    p.write(0, load32(one_time, 0).to_u64() % 67108864);
    p.write(1, load32(one_time, 3).to_u64() / 4 % 67108864);
    p.write(2, load32(one_time, 6).to_u64() / 16 % 67108864);
    p.write(3, load32(one_time, 9).to_u64() / 64 % 67108864);
    p.write(4, load32(one_time, 12).to_u64() / 256);
    Range(0, 5).loop((i) { p.write(5 + i, 0); });
    Range(0, 4).loop((i) { p.write(10 + i, load32(one_time, 16 + i * 4).to_u64()); });
}
stream_xor = (
    scratch : Ptr<u64>,
    output  : Ptr<u8>,
    input   : Ptr<u8>,
    count   : usize
) {
    offset: usize ::= 0; counter: u32 ::= 1;
    (offset < count).loop((loop) {
        block(scratch, counter);
        take       = (count - offset).min(64);
        key_stream = scratch.offset(16).to<u8>();
        Range(0, take).loop((i) {
            output.write(
                offset + i,
                byte(
                    input.read(offset + i).to_u32().bit_xor(key_stream.read(i).to_u32()).to_u64()
                )
            );
        });
        offset  = offset + take;
        counter = counter +% 1;
    });
}
// Five base-2^26 limbs modulo 2^130-5. Every block here is exactly16bytes:
// AEAD pads the AAD and ciphertext separately before the length block.
poly_block = (p: Ptr<u64>, input: Ptr<u8>) {
    h0 = p.read(5) +% load32(input, 0).to_u64() % 67108864;
    h1 = p.read(6) +% load32(input, 3).to_u64() / 4 % 67108864;
    h2 = p.read(7) +% load32(input, 6).to_u64() / 16 % 67108864;
    h3 = p.read(8) +% load32(input, 9).to_u64() / 64 % 67108864;
    h4 = p.read(9) +% load32(input, 12).to_u64() / 256 +% 16777216;
    r0 = p.read(0); r1 = p.read(1); r2 = p.read(2); r3 = p.read(3); r4 = p.read(4);
    // Products/sums fit u64 (each limb <2^27, each r <2^26); wrapping
    // spelling avoids secret-dependent overflow checks in generated code.
    d0  = h0*%r0 +% 5*%(h1*%r4 +% h2*%r3 +% h3*%r2 +% h4*%r1);
    d1  = h0*%r1 +% h1*%r0 +% 5*%(h2*%r4 +% h3*%r3 +% h4*%r2) +% d0 / 67108864;
    d2  = h0*%r2 +% h1*%r1 +% h2*%r0 +% 5*%(h3*%r4 +% h4*%r3) +% d1 / 67108864;
    d3  = h0*%r3 +% h1*%r2 +% h2*%r1 +% h3*%r0 +% 5*%h4*%r4 +% d2 / 67108864;
    d4  = h0*%r4 +% h1*%r3 +% h2*%r2 +% h3*%r1 +% h4*%r0 +% d3 / 67108864;
    low = d0 % 67108864 +% 5*%(d4 / 67108864);
    p.write(5, low % 67108864); p.write(6, d1 % 67108864 +% low / 67108864);
    p.write(7, d2 % 67108864); p.write(8, d3 % 67108864); p.write(9, d4 % 67108864);
}
poly_padded = (p: Ptr<u64>, buffer: Ptr<u8>, input: Ptr<u8>, count: usize) {
    offset: usize ::= 0;
    (count - offset >= 16).loop(
        (loop) { poly_block(p, input.offset(offset)); offset = offset + 16; }
    );
    (count != offset).then(() {
        Range(0, 16).loop((i) { buffer.write(i, 0); });
        Range(0, count - offset).loop((i) { buffer.write(i, input.read(offset + i)); });
        poly_block(p, buffer);
    });
}
poly_finish = (p: Ptr<u64>, output: Ptr<u8>) {
    // Normalize, then select h or h-p using an arithmetic mask, never a
    // secret-dependent early exit. Compiler/architecture timing is not audited.
    h1 = p.read(6); h2 = p.read(7) +% h1 / 67108864;
    h3 = p.read(8) +% h2 / 67108864; h4 = p.read(9) +% h3 / 67108864;
    h0 = p.read(5) +% 5*%(h4 / 67108864);
    p.write(5, h0 % 67108864); p.write(6, h1 % 67108864 +% h0 / 67108864);
    p.write(7, h2 % 67108864); p.write(8, h3 % 67108864); p.write(9, h4 % 67108864);
    g0 = p.read(5) +% 5; g1 = p.read(6) +% g0 / 67108864;
    g2 = p.read(7) +% g1 / 67108864; g3 = p.read(8) +% g2 / 67108864;
    g4      = (p.read(9) +% g3 / 67108864) -% 67108864;
    mask    = (g4 / 9223372036854775808) -% 1;
    inverse = mask.bit_xor(18446744073709551615);
    p.write(5, (g0 % 67108864).bit_and(mask) +% p.read(5).bit_and(inverse));
    p.write(6, (g1 % 67108864).bit_and(mask) +% p.read(6).bit_and(inverse));
    p.write(7, (g2 % 67108864).bit_and(mask) +% p.read(7).bit_and(inverse));
    p.write(8, (g3 % 67108864).bit_and(mask) +% p.read(8).bit_and(inverse));
    p.write(9, g4.bit_and(mask) +% p.read(9).bit_and(inverse));
    f0 = (p.read(5) +% p.read(6)*%67108864) % 4294967296 +% p.read(10);
    f1 = (p.read(6)/64 +% p.read(7)*%1048576) % 4294967296 +% p.read(11) +% f0/4294967296;
    f2 = (p.read(7)/4096 +% p.read(8)*%16384) % 4294967296 +% p.read(12) +% f1/4294967296;
    f3 = (p.read(8)/262144 +% p.read(9)*%256) % 4294967296 +% p.read(13) +% f2/4294967296;
    store(output, f0, 4); store(output.offset(4), f1, 4);
    store(output.offset(8), f2, 4); store(output.offset(12), f3, 4);
}
authenticate = (
    scratch    : Ptr<u64>,
    aad        : Ptr<u8>,
    aad_count  : usize,
    ciphertext : Ptr<u8>,
    count      : usize
) {
    p = scratch.offset(24); buffer = scratch.offset(38).to<u8>();
    poly_padded(p, buffer, aad, aad_count); poly_padded(p, buffer, ciphertext, count);
    store(buffer, aad_count.to_u64(), 8); store(buffer.offset(8), count.to_u64(), 8);
    poly_block(p, buffer); poly_finish(p, buffer);
}
