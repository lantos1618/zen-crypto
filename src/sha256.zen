// Experimental native SHA-256, RFC 6234. No side-channel/erasure guarantee.
// Caller owns 72 aligned u32 words and 64 writable bytes, mutually disjoint
// and disjoint from input/output. Pointers and capacities are caller contracts.
Ptr = std.mem
Range = std.core
bit_xor, bit_and, rotate_right, shift_right, to_u32, to_u64, to_u8, to_usize = std.core.num

Sha256* = {
    words: Ptr<u32>,
    block: Ptr<u8>,
    count :: u64 = 0,
    used :: usize = 0,
    active :: bool = true,

    update* = (self :: @Self, input: Ptr<u8>, count: usize) bool {
        (self.active && (count == 0 || !input.is_null())
            && count.to_u64() <= 2305843009213693951 - self.count).match({
            false => false,
            true  => {
                Range(0, count).loop((i) {
                    self.block.write(self.used, input.read(i));
                    self.used = self.used + 1;
                    (self.used == 64).then(() {
                        compress(self.words, self.block);
                        self.used = 0;
                    });
                });
                self.count = self.count + count.to_u64();
                true
            },
        })
    }

    finish* = (self :: @Self, output: Ptr<u8>, capacity: usize) bool {
        (self.active && capacity >= 32 && !output.is_null()).match({
            false => false,
            true  => {
                self.block.write(self.used, 128);
                self.used = self.used + 1;
                (self.used > 56).then(() {
                    Range(self.used, 64).loop((i) { self.block.write(i, 0); });
                    compress(self.words, self.block);
                    self.used = 0;
                });
                Range(self.used, 56).loop((i) { self.block.write(i, 0); });
                bits: u64 ::= self.count * 8;
                Range(0, 8).loop((i) {
                    self.block.write(
                        63 - i,
                        (bits % 256).to_usize().value_or(0).to_u8().value_or(0)
                    );
                    bits = bits / 256;
                });
                compress(self.words, self.block);
                Range(0, 32).loop((i) {
                    output.write(
                        i,
                        (self.words.read(i / 4).shift_right((3 - i % 4) * 8) % 256).to_u8().value_or(0)
                    );
                });
                self.active = false;
                true
            },
        })
    }
}

sha256_init* = (
    words          : Ptr<u32>,
    word_count     : usize,
    block          : Ptr<u8>,
    block_capacity : usize
) Res<Sha256> {
    (word_count >= 72 && block_capacity >= 64 && !words.is_null() && !block.is_null()).ensure().try();
    words.write(0, 1779033703); words.write(1, 3144134277);
    words.write(2, 1013904242); words.write(3, 2773480762);
    words.write(4, 1359893119); words.write(5, 2600822924);
    words.write(6, 528734635); words.write(7, 1541459225);
    Ok(Sha256(words: words, block: block))
}

sha256_candidate* = (
    output        : Ptr<u8>,
    capacity      : usize,
    input         : Ptr<u8>,
    count         : usize,
    bytes         : Ptr<u8>,
    byte_capacity : usize,
    words         : Ptr<u32>,
    word_count    : usize
) bool {
    (capacity >= 32 && !output.is_null() && (count == 0 || !input.is_null())
        && count.to_u64() <= 2305843009213693951).match({
        false => false,
        true  => sha256_init(words, word_count, bytes, byte_capacity).match({
            None        => false,
            Ok(initial) => {
                state ::= initial;
                state.update(input, count) && state.finish(output, capacity)
            },
        }),
    })
}

compress = (state: Ptr<u32>, block: Ptr<u8>) {
    w = state.offset(8);
    Range(0, 16).loop((i) {
        word: u32 ::= 0;
        Range(0, 4).loop((j) { word = word *% 256 +% block.read(i * 4 + j).to_u32(); });
        w.write(i, word);
    });
    Range(16, 64).loop((i) {
        x = w.read(i - 15); y = w.read(i - 2);
        s0 = x.rotate_right(7).bit_xor(x.rotate_right(18)).bit_xor(x.shift_right(3));
        s1 = y.rotate_right(17).bit_xor(y.rotate_right(19)).bit_xor(y.shift_right(10));
        w.write(i, w.read(i - 16) +% s0 +% w.read(i - 7) +% s1);
    });
    a: u32 ::= state.read(0); b: u32 ::= state.read(1);
    c: u32 ::= state.read(2); d: u32 ::= state.read(3);
    e: u32 ::= state.read(4); f: u32 ::= state.read(5);
    g: u32 ::= state.read(6); h: u32 ::= state.read(7);
    Range(0, 64).loop((i) {
        s1       = e.rotate_right(6).bit_xor(e.rotate_right(11)).bit_xor(e.rotate_right(25));
        choose   = e.bit_and(f.bit_xor(g)).bit_xor(g);
        t1       = h +% s1 +% choose +% constant(i) +% w.read(i);
        s0       = a.rotate_right(2).bit_xor(a.rotate_right(13)).bit_xor(a.rotate_right(22));
        majority = a.bit_and(b).bit_xor(a.bit_and(c)).bit_xor(b.bit_and(c));
        t2       = s0 +% majority;
        h        = g; g = f; f = e; e = d +% t1;
        d = c; c = b; b = a; a = t1 +% t2;
    });
    state.write(0, state.read(0) +% a); state.write(1, state.read(1) +% b);
    state.write(2, state.read(2) +% c); state.write(3, state.read(3) +% d);
    state.write(4, state.read(4) +% e); state.write(5, state.read(5) +% f);
    state.write(6, state.read(6) +% g); state.write(7, state.read(7) +% h);
}

