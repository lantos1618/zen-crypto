// Vetted native backend. Caller owns all buffers and must initialize first.
// Direct header bindings only: no hand-written C wrappers or crypto primitives.
// Byte counts and pointer lifetimes are caller obligations. No pointer retained.
Ptr, null_ptr = std.mem
Sodium* = c.bind("sodium.h", {
    sodium_init* = () i32
    sodium_hex2bin* = (output: Ptr<u8>, capacity: usize, hex: Ptr<c_char>, length: usize, ignore: Ptr<c_char>, decoded: Ptr<usize>, end: Ptr<Ptr<c_char>>) i32
    sodium_memzero* = (bytes: Ptr<()>, count: usize) ()
    sodium_memcmp* = (left: Ptr<()>, right: Ptr<()>, count: usize) i32
    randombytes_buf* = (bytes: Ptr<()>, count: usize) ()
    crypto_kx_keypair* = (public_key: Ptr<u8>, secret_key: Ptr<u8>) i32
    crypto_kx_client_session_keys* = (rx: Ptr<u8>, tx: Ptr<u8>, public_key: Ptr<u8>, secret_key: Ptr<u8>, peer_key: Ptr<u8>) i32
    crypto_kx_server_session_keys* = (rx: Ptr<u8>, tx: Ptr<u8>, public_key: Ptr<u8>, secret_key: Ptr<u8>, peer_key: Ptr<u8>) i32
    crypto_auth* = (tag: Ptr<u8>, message: Ptr<u8>, count: u64, key: Ptr<u8>) i32
    crypto_auth_verify* = (tag: Ptr<u8>, message: Ptr<u8>, count: u64, key: Ptr<u8>) i32
    crypto_generichash* = (output: Ptr<u8>, output_count: usize, input: Ptr<u8>, input_count: u64, key: Ptr<u8>, key_count: usize) i32
    crypto_aead_xchacha20poly1305_ietf_encrypt* = (output: Ptr<u8>, output_count: Ptr<u64>, message: Ptr<u8>, message_count: u64, ad: Ptr<u8>, ad_count: u64, secret_nonce: Ptr<u8>, nonce: Ptr<u8>, key: Ptr<u8>) i32
    crypto_aead_xchacha20poly1305_ietf_decrypt* = (output: Ptr<u8>, output_count: Ptr<u64>, secret_nonce: Ptr<u8>, ciphertext: Ptr<u8>, ciphertext_count: u64, ad: Ptr<u8>, ad_count: u64, nonce: Ptr<u8>, key: Ptr<u8>) i32
})

// Initialize once before use; libsodium accepts repeated initialization.
initialize* = () bool { Sodium.sodium_init() >= 0 }

// Counts are bytes. Nonzero counts require live caller-owned buffers.
// These delegate secure erasure/comparison to libsodium, never ordinary memcpy
// or a language loop. Equal-length comparison is constant-time in libsodium;
// this is not a whole-program side-channel guarantee.
wipe* = (bytes: Ptr<u8>, count: usize) () {
    (count > 0).then(() { Sodium.sodium_memzero(bytes.to<()>(), count); });
}
equal* = (left: Ptr<u8>, right: Ptr<u8>, count: usize) bool {
    count == 0 || Sodium.sodium_memcmp(left.to<()>(), right.to<()>(), count) == 0
}
// Strict hex, exactly count bytes: no separators or partial decoding accepted.
// Input and output must not overlap. Failure wipes the entire output region.
// Length/validity are observable; no timing promise for invalid input.
decode_secret_hex* = (text: str, output: Ptr<u8>, count: usize) bool {
    valid = text.len % 2 == 0 && text.len / 2 == count;
    good = valid && (count == 0 || Sodium.sodium_hex2bin(output, count, text.ptr().to<c_char>(), text.len, null_ptr<c_char>(), null_ptr<usize>(), null_ptr<Ptr<c_char>>()) == 0);
    (!good).then(() { wipe(output, count); });
    good
}
