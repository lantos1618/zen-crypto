// TLS client transport over OpenSSL. Owns verification, ALPN, I/O and native
// lifetimes. Transport is the shared shape for plain TCP and TLS connections.

Alloc, AllocError, Ptr, null_ptr = std.mem
str = std.text
Res = std.core
Drop = std.core
Vec = std.collections
callback = std.native
Socket = std.net.socket
TcpStream, TcpError = std.net.tcp

SSL_VERIFY_PEER: i32 = 1
SSL_CTRL_SET_TLSEXT_HOSTNAME: i32 = 55
X509_CHECK_FLAG_NO_PARTIAL_WILDCARDS: u32 = 4
SSL_ERROR_WANT_READ: i32 = 2
SSL_ERROR_WANT_WRITE: i32 = 3
SSL_ERROR_ZERO_RETURN: i32 = 6

Native = c.bind("zen_tls.h", {
    SSL_TLSEXT_ERR_OK: i32
    SSL_TLSEXT_ERR_ALERT_FATAL: i32
    zen_tls_set_alpn_callback = (ctx: Ptr<()>, callback: Ptr<()>) ()
    zen_tls_has_h2 = (session: Ptr<()>) i32
    TLS1_3_VERSION: i32
    SSL_FILETYPE_PEM: i32
    SSL_OP_NO_COMPRESSION: u64
    zen_tls_server_method = () Ptr<()>
    SSL_CTX_new = (method: Ptr<()>) Ptr<()>
    SSL_CTX_set_min_proto_version = (ctx: Ptr<()>, version: i32) i64
    SSL_CTX_set_max_proto_version = (ctx: Ptr<()>, version: i32) i64
    SSL_CTX_set_ciphersuites = (ctx: Ptr<()>, suites: Ptr<c_char>) i32
    SSL_CTX_use_certificate_chain_file = (ctx: Ptr<()>, path: Ptr<c_char>) i32
    SSL_CTX_use_PrivateKey_file = (ctx: Ptr<()>, path: Ptr<c_char>, kind: i32) i32
    SSL_CTX_check_private_key = (ctx: Ptr<()>) i32
    SSL_CTX_set_read_ahead = (ctx: Ptr<()>, enabled: i32) ()
    SSL_CTX_set_options = (ctx: Ptr<()>, options: u64) u64
    ERR_clear_error = () ()
    SSL_read = (ssl: Ptr<()>, bytes: Ptr<u8>, len: usize) i32
    SSL_write = (ssl: Ptr<()>, bytes: Ptr<u8>, len: usize) i32
    SSL_has_pending = (ssl: Ptr<()>) i32
    zen_tls_client_context = () Ptr<()>
    SSL_CTX_free = (ctx: Ptr<()>) ()
    SSL_CTX_set_default_verify_paths = (ctx: Ptr<()>) i32
    SSL_CTX_set_verify = (ctx: Ptr<()>, mode: i32, callback: Ptr<()>) ()
    SSL_CTX_set_alpn_protos = (
        ctx           : Ptr<()>,
        protocols     : Ptr<u8>,
        protocols_len : u32
    ) i32
    SSL_new = (ctx: Ptr<()>) Ptr<()>
    SSL_free = (ssl: Ptr<()>) ()
    zen_tls_set_fd = (ssl: Ptr<()>, fd: i32) i32
    SSL_ctrl = (ssl: Ptr<()>, command: i32, larg: i64, parg: Ptr<()>) i64
    SSL_set_hostflags = (ssl: Ptr<()>, flags: u32) ()
    SSL_set1_host = (ssl: Ptr<()>, host: Ptr<c_char>) i32
    SSL_connect = (ssl: Ptr<()>) i32
    SSL_get_verify_result = (ssl: Ptr<()>) i64
    zen_tls_selected = (
        ssl          : Ptr<()>,
        selected     : Ptr<Ptr<u8>>,
        selected_len : Ptr<u32>
    ) ()
    SSL_write_ex = (
        ssl     : Ptr<()>,
        bytes   : Ptr<u8>,
        len     : usize,
        written : Ptr<usize>
    ) i32
    SSL_read_ex = (
        ssl   : Ptr<()>,
        bytes : Ptr<u8>,
        len   : usize,
        read  : Ptr<usize>
    ) i32
    SSL_get_error = (ssl: Ptr<()>, rc: i32) i32
    SSL_shutdown = (ssl: Ptr<()>) i32
})

TlsFault* = ConnectFailed | TlsFailed | WriteFailed | ReadFailed | Closed

alpn_h2 = (a: Alloc) Res<Vec<u8>, TlsFault> {
    out ::= a.Vec<u8>();
    out.add(2).try(TlsFault.TlsFailed);
    out.add('h').try(TlsFault.TlsFailed);
    out.add('2').try(TlsFault.TlsFailed);
    Ok(out)
}

tls_dial = (a: Alloc, host: str, port: u16, h2: bool)
           Res<TlsConnection, TlsFault> {
    socket ::= Socket.tcp_connect(a, host, port)
        .try(TlsFault.ConnectFailed);
    wrap_socket(a, consume socket, host, h2)
}

wrap_socket = (a: Alloc, socket :: Socket, host: str, h2: bool)
              Res<TlsConnection, TlsFault> {
    host_c    ::= host.c_text(a).try(TlsFault.TlsFailed);
    io_counts ::= a.Vec<usize>();
    io_counts.add(0).try(TlsFault.TlsFailed);
    io_counts.add(0).try(TlsFault.TlsFailed);
    ctx = Native.zen_tls_client_context();
    ctx.is_null().match({
        true  => Err(TlsFault.TlsFailed),
        false => wrap_ctx(a, consume socket, host_c, h2, ctx, io_counts),
    })
}

wrap_ctx = (
    a         : Alloc,
    socket    :: Socket,
    host_c    : Vec<u8>,
    h2        : bool,
    ctx       : Ptr<()>,
    io_counts : Vec<usize>
) Res<TlsConnection, TlsFault> {
    configured ::= Native.SSL_CTX_set_default_verify_paths(ctx) == 1;
    Native.SSL_CTX_set_verify(ctx, SSL_VERIFY_PEER, null_ptr<()>());
    h2.then(() {
        protocols ::= alpn_h2(a).try();
        (Native.SSL_CTX_set_alpn_protos(ctx, protocols.ptr(), 3) != 0).then(() {
            configured = false;
        });
    });
    configured.match({
        false => {
            Native.SSL_CTX_free(ctx);
            Err(TlsFault.TlsFailed)
        },
        true  => wrap_ssl(a, consume socket, host_c, ctx, io_counts),
    })
}

wrap_ssl = (
    a         : Alloc,
    socket    :: Socket,
    host_c    : Vec<u8>,
    ctx       : Ptr<()>,
    io_counts : Vec<usize>
)
           Res<TlsConnection, TlsFault> {
    ssl = Native.SSL_new(ctx);
    ssl.is_null().match({
        true  => {
            Native.SSL_CTX_free(ctx);
            Err(TlsFault.TlsFailed)
        },
        false => {
            Native.SSL_set_hostflags(ssl, X509_CHECK_FLAG_NO_PARTIAL_WILDCARDS);
            configured = Native.zen_tls_set_fd(
                ssl,
                socket.handle().raw_handle()
            ) == 1
                && Native.SSL_ctrl(
                    ssl,
                    SSL_CTRL_SET_TLSEXT_HOSTNAME,
                    0,
                    host_c.ptr().to<()>()
                ) == 1
                && Native.SSL_set1_host(ssl, host_c.ptr().to<c_char>()) == 1;
            connected  = configured
                && Native.SSL_connect(ssl) == 1
                && Native.SSL_get_verify_result(ssl) == 0;
            connected.match({
                true  => Ok(TlsConnection(
                    socket: consume socket,
                    alloc: a,
                    ssl: ssl,
                    ctx: ctx,
                    io_counts: io_counts
                )),
                false => {
                    Native.SSL_free(ssl);
                    Native.SSL_CTX_free(ctx);
                    Err(TlsFault.TlsFailed)
                },
            })
        },
    })
}

TlsConnection* = {
    socket :: Socket,
    alloc: Alloc,
    ssl: Ptr<()>,
    ctx: Ptr<()>,
    // OpenSSL output counters are connection-owned, reused on every I/O.
    io_counts: Vec<usize>,
    open :: bool = true,

    connect* = (a: Alloc, host: str, port: u16) Res<TlsConnection, TlsFault> {
        tls_dial(a, host, port, false)
    }

    alpn* = (self: @Self, buf :: Vec<u8>) Res<usize, TlsFault> {
        self.open.ensure(TlsFault.Closed).try();
        selected ::= self.alloc.Vec<Ptr<u8>>();
        selected.add(null_ptr<u8>()).try(TlsFault.ReadFailed);
        selected_len ::= self.alloc.Vec<u32>();
        selected_len.add(0).try(TlsFault.ReadFailed);
        Native.zen_tls_selected(self.ssl, selected.ptr(), selected_len.ptr());
        n = selected_len.ptr().read(0).to_usize();
        buf.reserve(n).try(TlsFault.ReadFailed);
        Range(0, n).loop((h, i) {
            buf.add(selected.ptr().read(0).read(i)).try(TlsFault.ReadFailed);
        });
        Ok(n)
    }

    write* = (self: @Self, bytes: str) Res<(), TlsFault> {
        self.open.ensure(TlsFault.Closed).try();
        sent ::= 0;
        written = self.io_counts.ptr();
        failed ::= false;
        loop(() { sent < bytes.len && !failed }, (h) {
            written.write(0, 0);
            rc = Native.SSL_write_ex(
                self.ssl,
                bytes.ptr().offset(sent),
                bytes.len - sent,
                written
            );
            (rc == 1).match({
                true  => (written.read(0) == 0).match({
                    true  => { failed = true; },
                    false => { sent = sent + written.read(0); },
                }),
                false => {
                    error = Native.SSL_get_error(self.ssl, rc);
                    (!(error == SSL_ERROR_WANT_READ
                        || error == SSL_ERROR_WANT_WRITE)).then(() {
                        failed = true;
                    });
                },
            });
        });
        failed.match({
            true  => Err(TlsFault.WriteFailed),
            false => Ok(()),
        })
    }

    read* = (self: @Self, buf :: Vec<u8>, n: usize) Res<usize, TlsFault> {
        self.open.ensure(TlsFault.Closed).try();
        (n == 0).match({
            true  => Ok(0),
            false => self.read_nonempty(buf, n),
        })
    }

    read_nonempty = (self: @Self, buf :: Vec<u8>, n: usize)
                    Res<usize, TlsFault> {
        buf.reserve(n).try(TlsFault.ReadFailed);
        got = self.io_counts.ptr().offset(1);
        got.write(0, 0);
        answer: Res<usize, TlsFault> = Err(TlsFault.ReadFailed);
        waiting ::= true;
        waiting.loop((h) {
            rc = Native.SSL_read_ex(self.ssl, buf.ptr(), n, got);
            (rc == 1).match({
                true  => {
                    answer  = Ok(got.read(0));
                    waiting = false;
                },
                false => {
                    error = Native.SSL_get_error(self.ssl, rc);
                    (!(error == SSL_ERROR_WANT_READ
                        || error == SSL_ERROR_WANT_WRITE)).then(() {
                        waiting = false;
                        (error == SSL_ERROR_ZERO_RETURN).then(() {
                            answer = Err(TlsFault.Closed);
                        });
                    });
                },
            });
        });
        answer
    }

    close* = (self :: @Self) () {
        self.open.then(() {
            self.open = false;
            Native.SSL_shutdown(self.ssl);
            Native.SSL_free(self.ssl);
            Native.SSL_CTX_free(self.ctx);
            self.socket.close();
        });
    }
}

TlsConnection.impl(Drop, {
    drop = (self :: @Self) () { self.close() }
})

// TlsFault covers both transports' faults. The union owns the stream it
// wraps: leaving scope closes it, and a `consume` into close disarms that
// drop so the fd and SSL context are released once.
Transport* = Tcp(TcpStream) | Tls(TlsConnection)

tls_error = (e: TcpError) TlsFault {
    e.match({
        ConnectFailed => TlsFault.ConnectFailed,
        WriteFailed   => TlsFault.WriteFailed,
        ReadFailed    => TlsFault.ReadFailed,
        Closed        => TlsFault.Closed,
    })
}

// `h2` offers ALPN h2 on a secure dial and is ignored on a plain one.
dial* = (a: Alloc, host: str, port: u16, secure: bool, h2: bool)
        Res<Transport, TlsFault> {
    secure.match({
        true  => tls_dial(a, host, port, h2).match({
            Ok(s)  => Ok(Transport.Tls(s)),
            Err(e) => Err(e),
        }),
        false => TcpStream.connect(a, host, port).match({
            Ok(s)  => Ok(Transport.Tcp(s)),
            Err(e) => Err(e.tls_error()),
        }),
    })
}

write* = (self: Transport, bytes: str) Res<(), TlsFault> {
    self.match({
        Tcp(t) => t.write(bytes).match({
            Ok(_)  => Ok(()),
            Err(e) => Err(e.tls_error()),
        }),
        Tls(t) => t.write(bytes),
    })
}

read* = (self: Transport, buf :: Vec<u8>, n: usize) Res<usize, TlsFault> {
    self.match({
        Tcp(t) => t.read(buf, n).match({
            Ok(got) => Ok(got),
            Err(e)  => Err(e.tls_error()),
        }),
        Tls(t) => t.read(buf, n),
    })
}

close* = (self: Transport) () {
    self.match({
        Tcp(t) => t.close(),
        Tls(t) => t.close(),
    })
}

Transport.impl(Drop, {
    drop = (self :: @Self) () { self.close() }
})

// Owns server TLS policy and context lifetime. Socket adapters borrow handle.
ServerContext* = {
    handle*: Ptr<()>,
    enable_h2* = (self: @Self) { Native.zen_tls_set_alpn_callback(
        self.handle,
        callback(select_h2)
    ); }
    create* = (a: Alloc, certificate: str, private_key: str) Res<ServerContext, TlsFault> {
        (!certificate.contains(0) && !private_key.contains(0)).ensure(TlsFault.TlsFailed).try();
        cert   = certificate.c_text(a).try(TlsFault.TlsFailed);
        key    = private_key.c_text(a).try(TlsFault.TlsFailed);
        suites = "TLS_AES_128_GCM_SHA256".c_text(a).try(TlsFault.TlsFailed);
        ctx    = Native.SSL_CTX_new(Native.zen_tls_server_method());
        (!ctx.is_null()).ensure(TlsFault.TlsFailed).try();
        valid = Native.SSL_CTX_set_min_proto_version(
            ctx,
            Native.TLS1_3_VERSION
        ) != 0
            && Native.SSL_CTX_set_max_proto_version(
                ctx,
                Native.TLS1_3_VERSION
            ) != 0
            && Native.SSL_CTX_set_ciphersuites(
                ctx,
                suites.ptr().to<c_char>()
            ) == 1
            && Native.SSL_CTX_use_certificate_chain_file(
                ctx,
                cert.ptr().to<c_char>()
            ) == 1
            && Native.SSL_CTX_use_PrivateKey_file(
                ctx,
                key.ptr().to<c_char>(),
                Native.SSL_FILETYPE_PEM
            ) == 1
            && Native.SSL_CTX_check_private_key(ctx) == 1;
        valid.match({
            false => { Native.SSL_CTX_free(ctx); Err(TlsFault.TlsFailed) },
            true  => {
                Native.SSL_CTX_set_read_ahead(ctx, 1);
                Native.SSL_CTX_set_options(ctx, Native.SSL_OP_NO_COMPRESSION);
                Ok(ServerContext(handle: ctx))
            },
        })
    }
}
ServerContext.impl(Drop, {
    drop = (self :: @Self) { Native.SSL_CTX_free(self.handle); }
})

// Borrowed-session nonblocking operation. The caller keeps the same operation,
// buffer address and length until a retry succeeds, and owns socket readiness.
ServerIo* = Bytes(i64) | WantRead | WantWrite | Closed
server_io* = (
    session : Ptr<()>,
    bytes   : Ptr<u8>,
    len     : usize,
    writing : bool
) ServerIo {
    (len > 0 && len <= 2147483647 && !session.is_null()).match({
        false => ServerIo.Closed,
        true  => {
            Native.ERR_clear_error();
            n = writing.match({
                true  => Native.SSL_write(session, bytes, len),
                false => Native.SSL_read(session, bytes, len),
            });
            (n > 0).match({
                true  => ServerIo.Bytes(n.to_i64()),
                false => {
                    error = Native.SSL_get_error(session, n);
                    (error == SSL_ERROR_WANT_READ).match({
                        true  => ServerIo.WantRead,
                        false => (error == SSL_ERROR_WANT_WRITE).match({
                            true  => ServerIo.WantWrite,
                            false => ServerIo.Closed,
                        }),
                    })
                },
            })
        },
    })
}
server_pending* = (session: Ptr<()>) bool {
    !session.is_null() && Native.SSL_has_pending(session) != 0
}

// Native ALPN callback: validate the complete length-prefixed offer and select
// only h2. OpenSSL owns the offered storage throughout callback processing.
select_h2 = (
    session      : Ptr<()>,
    selected     : Ptr<Ptr<u8>>,
    selected_len : Ptr<u8>,
    offered      : Ptr<u8>,
    length       : u32,
    argument     : Ptr<()>
) i32 {
    at    ::= 0;
    found ::= null_ptr<u8>();
    valid ::= true;
    loop((h) {
        (at >= length.to_usize()).then(() { h.break(); });
        n  = offered.read(at).to_usize();
        at = at + 1;
        (n == 0 || n > length.to_usize() - at).then(
            () { valid = false; h.break(); }
        );
        (n == 2 && offered.read(at) == 'h' && offered.read(at + 1) == '2').then(() { found = offered.offset(at); });
        at = at + n;
    });
    (valid && !found.is_null()).match({
        true  => { selected.write(0, found); selected_len.write(0, 2); Native.SSL_TLSEXT_ERR_OK },
        false => Native.SSL_TLSEXT_ERR_ALERT_FATAL,
    })
}
server_h2_selected* = (session: Ptr<()>) bool {
    !session.is_null() && Native.zen_tls_has_h2(session) == 1
}
