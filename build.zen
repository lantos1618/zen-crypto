Builder, BuildError = std.build
build = (b :: Builder) Res<(), BuildError> {
    crypto = b.lib(
        "crypto",
        {src: Path("src/crypto.zen"), libs: [], paths: []}
    ).try();
    b.exe(
        "test",
        {src: Path("tests/main.zen"), deps: [crypto], out: Ok(Path("build/test"))}
    ).try();
    blake2b = b.lib(
        "blake2b",
        {src: Path("src/blake2b.zen"), libs: [], paths: []}
    ).try();
    b.exe(
        "test-blake2b",
        {src: Path("tests/blake2b_native_test.zen"), deps: [blake2b], out: Ok(Path("build/test-blake2b"))}
    ).try();
    aead = b.lib(
        "chacha20poly1305",
        {src: Path("src/chacha20poly1305.zen"), libs: [], paths: []}
    ).try();
    b.exe(
        "test-chacha20poly1305",
        {src: Path("tests/chacha20poly1305_native.zen"), deps: [aead], out: Ok(Path("build/test-chacha20poly1305"))}
    ).try();
    x25519 = b.lib(
        "x25519",
        {src: Path("src/x25519.zen"), libs: [], paths: []}
    ).try();
    x25519_support = b.lib(
        "x25519_test_support",
        {src: Path("tests/x25519_test_support.zen"), libs: [], paths: []}
    ).try();
    b.exe(
        "test-x25519",
        {src: Path("tests/x25519_native_test.zen"), deps: [x25519, x25519_support], out: Ok(Path("build/test-x25519"))}
    ).try();
    Ok(())
}
