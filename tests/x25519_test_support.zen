x25519_public_key, x25519_shared_secret = x25519

nibble = (v: u8) u8 { (v <= 57).match({true => v - 48, false => v - 87}) }
decode = (out: Ptr<u8>, text: str) {
    Range(0, 32).loop((i) { out.write(i, nibble(text.ptr().read(i * 2)) * 16 + nibble(text.ptr().read(i * 2 + 1))); });
}
matches = (out: Ptr<u8>, text: str) bool {
    good ::= true;
    Range(0, 32).loop((i) { good = (out.read(i) == nibble(text.ptr().read(i * 2)) * 16 + nibble(text.ptr().read(i * 2 + 1))) && good; });
    good
}
Harness* = {
    bytes: Ptr<u8>, words: Ptr<u64>,

    vector* = (self: @Self, key_hex: str, peer_hex: str, expected: str, public: bool) bool {
        key = self.bytes.offset(1); peer = self.bytes.offset(65); output = self.bytes.offset(129);
        good ::= true;
        // Distinct output, exact key alias, exact peer alias, and partial key/peer
        // overlap exercise the documented consume-before-write contract.
        Range(0, 5).loop((mode) {
            Range(0, 200).loop((i) { self.bytes.write(i, 165); });
            decode(key, key_hex); decode(peer, peer_hex);
            self.words.write(0, 123456789); self.words.write(353, 987654321);
            out    = mode.match({0 => output, 1 => key, 2 => peer, 3 => key.offset(1), _ => peer.offset(1)});
            result = public.match({
                true  => x25519_public_key(
                    out,
                    32,
                    key,
                    self.words.offset(1),
                    352
                ),
                false => x25519_shared_secret(
                    out,
                    32,
                    key,
                    peer,
                    self.words.offset(1),
                    352
                ),
            });
            good   = result && matches(out, expected) && good;
            good   = self.words.read(0) == 123456789 && self.words.read(353) == 987654321 && good;
            good   = self.bytes.read(0) == 165 && self.bytes.read(64) == 165
                && ((mode == 4) || self.bytes.read(97) == 165) && self.bytes.read(98) == 165 && self.bytes.read(128) == 165
                && self.bytes.read(161) == 165 && good;
        });
        good
    }

    reject* = (self: @Self, key_hex: str, peer_hex: str) bool {
        key = self.bytes; peer = self.bytes.offset(64); output = self.bytes.offset(128);
        good ::= true;
        Range(0, 3).loop((mode) {
            decode(key, key_hex); decode(peer, peer_hex);
            Range(0, 32).loop((i) { output.write(i, 165); });
            out  = mode.match({0 => output, 1 => key, _ => peer});
            good = !x25519_shared_secret(
                out,
                32,
                key,
                peer,
                self.words.offset(1),
                352
            ) && good;
            good = matches(key, key_hex) && matches(peer, peer_hex) && good;
            Range(0, 32).loop((i) { good = output.read(i) == 165 && good; });
        });
        good
    }

    invalid* = (self: @Self) bool {
        key = self.bytes; peer = self.bytes.offset(64); output = self.bytes.offset(128); s = self.words.offset(1);
        Range(0, 200).loop((i) { self.bytes.write(i, 165); });
        Range(0, 354).loop((i) { self.words.write(i, 12345); });
        good ::= !x25519_public_key(null_ptr<u8>(), 32, key, s, 352)
            && !x25519_public_key(output, 31, key, s, 352)
            && !x25519_public_key(output, 32, null_ptr<u8>(), s, 352)
            && !x25519_public_key(output, 32, key, null_ptr<u64>(), 352)
            && !x25519_public_key(output, 32, key, s, 351)
            && !x25519_shared_secret(null_ptr<u8>(), 32, key, peer, s, 352)
            && !x25519_shared_secret(output, 31, key, peer, s, 352)
            && !x25519_shared_secret(output, 32, null_ptr<u8>(), peer, s, 352)
            && !x25519_shared_secret(output, 32, key, null_ptr<u8>(), s, 352)
            && !x25519_shared_secret(
                output,
                32,
                key,
                peer,
                null_ptr<u64>(),
                352
            )
            && !x25519_shared_secret(output, 32, key, peer, s, 351);
        Range(0, 200).loop((i) { good = self.bytes.read(i) == 165 && good; });
        Range(0, 354).loop((i) { good = self.words.read(i) == 12345 && good; });
        good
    }

    iterations* = (self: @Self) bool {
        key = self.bytes; peer = self.bytes.offset(64); output = self.bytes.offset(128);
        Range(0, 32).loop((i) { key.write(i, 0); peer.write(i, 0); });
        key.write(0, 9); peer.write(0, 9);
        good ::= true;
        Range(0, 1000).loop((step) {
            good = x25519_shared_secret(
                output,
                32,
                key,
                peer,
                self.words.offset(1),
                352
            ) && good;
            peer.copy_from(key, 32); key.copy_from(output, 32);
            (step == 0).then(
                () { good = matches(
                    key,
                    "422c8e7a6227d7bca1350b3e2bb7279f7897b87bb6854b783c60e80311ae3079"
                ) && good; }
            );
        });
        matches(
            key,
            "684cf59ba83309552800ef566f2f4d3c1c3887c49360e3875f2eb94d99532c51"
        ) && good
    }
}
